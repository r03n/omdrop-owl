+	if (state->election.custom_metric) {
+		tlv->ht_capabilities = htole16(0x11ee); /* 0x11ce with Bit 5 set: Short GI for 20 MHz */
+		tlv->ampdu_params = 0x1b;
+		tlv->rx_mcs = 0xff; /* stream 1: all MCS (0..7) */
+		tlv->unknown = htole16(0);
